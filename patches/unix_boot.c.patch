+/*
+ *  Serial mirror (2026-07-14): the loader's diagnostics used to be screen-only,
+ *  i.e. photo-only on real HW and screenshot-only on the emulator (the console
+ *  wraps at ~40 lines).  Mirror every diagnostic line to the custom-chip serial
+ *  port -- the SAME registers and 9600 baud as the kernel's serdbg.s conputc
+ *  hook, so one capture (Amiberry TCP:1234 / a future real serial cable) holds
+ *  the loader AND kernel output.  Direct SERDAT banging: no serial.device
+ *  dependency, interrupt-free, safe right up to the supervisor() handoff.
+ */
+#define CUSTOM_SERPER  (*(volatile unsigned short *)0xDFF032)
+#define CUSTOM_SERDAT  (*(volatile unsigned short *)0xDFF030)
+#define CUSTOM_SERDATR (*(volatile unsigned short *)0xDFF018)
+
+static int ser_up = 0;
+
+static void
+ser_putc (c)
+int c;
+{
+    long guard;
+
+    if (!ser_up) {
+	CUSTOM_SERPER = 0x0174;			/* 9600 baud (PAL clock) */
+	ser_up = 1;
+    }
+    CUSTOM_SERDAT = 0x0100 | (c & 0xff);	/* STOPBIT | char */
+    for (guard = 0x10000; guard > 0; guard--)	/* bounded TBE wait */
+	if (CUSTOM_SERDATR & 0x2000)
+	    break;
+}
+
+static void
+ser_puts (s)
+const char *s;
+{
+    while (*s) {
+	if (*s == '\n')
+	    ser_putc ('\r');
+	ser_putc (*s++);
+    }
+}
+
+/*
+ *  dprintf: fprintf(stderr, ...) replacement that also mirrors to serial.
+ *  All diagnostic lines here are short; 512 bytes is ample.
+ *
+ *  __stdargs is MANDATORY (2026-07-15): bebbo amiga-gcc defaults to a regargs
+ *  ABI in which the first few arguments come in registers.  A custom variadic
+ *  function without __stdargs makes va_start() compute the wrong stack origin,
+ *  so vsnprintf() reads garbage for the varargs (observed: the multi-%d
+ *  AttnFlags line printed junk while shorter lines happened to survive).
+ *  Forcing __stdargs puts every argument on the stack, matching clib2's own
+ *  __stdargs vsnprintf and the classic printf ABI va_start expects.
+ */
+static void __stdargs
+dprintf (const char *fmt, ...)
+{
+    char buf[512];
+    va_list ap;
+
+    va_start (ap, fmt);
+    vsnprintf (buf, sizeof (buf), fmt, ap);
+    va_end (ap);
+    fputs (buf, stderr);
+    ser_puts (buf);
+}
