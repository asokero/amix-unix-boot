@@ -136,6 +137,41 @@
 		*(long *)datap = vaddr + relp -> r_addend;
 		DBUG_PRINT ("reloc", ("reloc to %#lx", *(long *)datap));
 		break;
+	    /*
+	     * PC-relative relocations (S + A - P, where P is the RUNTIME address
+	     * of the relocation site = this section's bound vaddr + r_offset).
+	     * The stock loader handled only R_68K_32, so any object assembled by
+	     * the GNU m68k toolchain -- which keeps cross-file bsr/bra/lea PC-rel
+	     * references as relocations through `ld -r` -- was rejected with the
+	     * "RELA" dead-end Alert (0x52454C41|AT_DeadEnd = Guru D245 4C41).
+	     * That is what blocked linking the Motorola 040 FPSP (330 PC-rel
+	     * records) into the kernel.  Out-of-range displacements still
+	     * COMPLAIN, so a truncation can never be silent.
+	     */
+	    case R_68K_PC32:
+		pcrel = (long) (vaddr + relp -> r_addend)
+			- (long) (relsechdr -> sh_addr + relp -> r_offset);
+		*(long *)datap = pcrel;
+		DBUG_PRINT ("reloc", ("pcrel32 %#lx", pcrel));
+		break;
+	    case R_68K_PC16:
+		pcrel = (long) (vaddr + relp -> r_addend)
+			- (long) (relsechdr -> sh_addr + relp -> r_offset);
+		if (pcrel < -32768L || pcrel > 32767L) {
+		    COMPLAIN ("PC16 relocation out of range: %ld\n", pcrel);
+		}
+		*(short *)datap = (short) pcrel;
+		DBUG_PRINT ("reloc", ("pcrel16 %#lx", pcrel));
+		break;
+	    case R_68K_PC8:
+		pcrel = (long) (vaddr + relp -> r_addend)
+			- (long) (relsechdr -> sh_addr + relp -> r_offset);
+		if (pcrel < -128L || pcrel > 127L) {
+		    COMPLAIN ("PC8 relocation out of range: %ld\n", pcrel);
+		}
+		*(char *)datap = (char) pcrel;
+		DBUG_PRINT ("reloc", ("pcrel8 %#lx", pcrel));
+		break;
