+/*
+ *	pokesymlong -- 060-B (2026-07-10): write a 32-bit value into the loaded
+ *	ELF image at the file location of a named data symbol.  unix_boot uses
+ *	this to set the kernel's `cputype` global (40/60, decided from
+ *	SysBase->AttnFlags) after relocation, so ONE kernel binary serves both
+ *	the 68040 and the 68060.
+ *
+ *	ET_REL kernels only (ours): a symbol's st_value is section-relative and
+ *	the section's sh_offset locates its bytes in the buffer.  Returns 1 on
+ *	success, 0 when the symtab or the symbol is absent or has no file bytes
+ *	-- an older kernel without `cputype` simply boots with its built-in
+ *	default, so the caller treats 0 as harmless.
+ */
+
+int pokesymlong (char *elfdata, char *name, unsigned long value)
+{
+    Elf32_Ehdr *ehdr;
+    Elf32_Shdr *shdrs;
+    Elf32_Shdr *symhdr = NULL;
+    Elf32_Shdr *strtabhdr;
+    Elf32_Shdr *deshdr;
+    Elf32_Sym *syms;
+    Elf32_Sym *sym;
+    char *strtab;
+    unsigned int nsyms;
+    unsigned int symidx;
+    unsigned int sectnum;
+
+    ehdr = (Elf32_Ehdr *) elfdata;
+    if (!streqn ((char *) (ehdr -> e_ident), RELOC (ELFMAG), SELFMAG))
+	return 0;
+    if (ehdr -> e_type != ET_REL)
+	return 0;
+    shdrs = (Elf32_Shdr *) (elfdata + ehdr -> e_shoff);
+    for (sectnum = 0; sectnum < ehdr -> e_shnum; sectnum++) {
+	if (shdrs[sectnum].sh_type == SHT_SYMTAB) {
+	    symhdr = shdrs + sectnum;
+	}
+    }
+    if (symhdr == NULL || symhdr -> sh_entsize == 0)
+	return 0;
+    nsyms = symhdr -> sh_size / symhdr -> sh_entsize;
+    syms = (Elf32_Sym *) (elfdata + symhdr -> sh_offset);
+    strtabhdr = shdrs + symhdr -> sh_link;
+    strtab = elfdata + strtabhdr -> sh_offset;
+    for (symidx = 0; symidx < nsyms; symidx++) {
+	sym = syms + symidx;
+	if (sym -> st_name && streq (strtab + sym -> st_name, name)) {
+	    if (sym -> st_shndx == 0 || sym -> st_shndx >= ehdr -> e_shnum)
+		continue;			/* undefined/ABS: keep looking */
+	    deshdr = shdrs + sym -> st_shndx;
+	    if (deshdr -> sh_type != SHT_PROGBITS)
+		return 0;			/* .bss symbol: no file bytes to poke */
+	    *(unsigned long *) (elfdata + deshdr -> sh_offset + sym -> st_value) = value;
+	    return 1;
+	}
+    }
+    return 0;
+}
+
